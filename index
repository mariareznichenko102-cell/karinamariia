<style>
  :root{
    --bg: #17151a;
    --bg-panel: #1e1c22;
    --line: #34313a;
    --ink: #f4f1ec;
    --ink-dim: #a9a4b0;
    --magenta: #ff3d81;
    --gold: #f2c230;
    --focus: #f4f1ec;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Manrope', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  ::selection{ background: var(--magenta); color: #17151a; }
  a{ color: inherit; }
  a:focus-visible, button:focus-visible{ outline: 2px solid var(--focus); outline-offset: 3px; }

  .display{
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 0.92;
  }

  .wrap{ max-width: 980px; margin: 0 auto; padding: 0 28px; }

  p{ margin: 0; }

  /* ---------- HERO ---------- */

  header.hero{ padding: 88px 0 0; border-bottom: 1px solid var(--line); }

  .hero-kicker{
    display:flex; align-items:center; gap:10px;
    font-size: 13px; color: var(--ink-dim); margin-bottom: 28px;
  }
  .hero-kicker .dot{ width:7px; height:7px; border-radius:50%; background: var(--gold); flex: none; }

  h1.hero-title{
    font-family:'Bebas Neue', sans-serif;
    font-size: clamp(48px, 9.5vw, 116px);
    margin: 0;
  }
  h1.hero-title span{
    display:block; opacity:0; transform: translateY(14px);
    animation: rise 0.7s cubic-bezier(.2,.7,.3,1) forwards;
  }
  h1.hero-title span:nth-child(2){ color: var(--magenta); }
  h1.hero-title span:nth-child(1){ animation-delay: 0s; }
  h1.hero-title span:nth-child(2){ animation-delay: .06s; }
  h1.hero-title span:nth-child(3){ animation-delay: .12s; }

  @keyframes rise{ to{ opacity:1; transform:none; } }

  .hero-copy{
    max-width: 580px; font-size: 18px; line-height: 1.55;
    color: var(--ink-dim); margin: 26px 0 48px;
  }
  .hero-copy strong{ color: var(--ink); font-weight: 700; }

  .marquee{ overflow: hidden; border-top: 1px solid var(--line); white-space: nowrap; position: relative; }
  .marquee-track{ display:inline-block; padding: 16px 0; animation: scroll 28s linear infinite; }
  .marquee span{
    font-family:'Bebas Neue', sans-serif; font-size: 20px;
    letter-spacing: 0.06em; color: var(--ink-dim); margin-right: 36px;
  }
  .marquee span.city{ color: var(--ink); }
  @keyframes scroll{ from{ transform: translateX(0); } to{ transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce){
    .marquee-track{ animation: none; }
    h1.hero-title span{ animation: none; opacity:1; transform:none; }
  }

  /* ---------- CHAPTERS (shared) ---------- */

  main{ padding: 64px 0 40px; }
  .chapter{ margin-bottom: 64px; }

  .chapter-head{ display:flex; align-items: baseline; gap: 16px; margin-bottom: 6px; }
  .chapter-num{ font-family:'Bebas Neue', sans-serif; font-size: 20px; color: var(--gold); }
  .chapter-title{
    font-family:'Bebas Neue', sans-serif;
    font-size: clamp(28px, 4.5vw, 40px);
    letter-spacing: 0.01em;
  }
  .chapter-sub{ color: var(--ink-dim); font-size: 14px; margin: 0 0 18px; padding-left: 46px; }

  @media (max-width: 620px){
    .chapter-sub{ padding-left: 0; }
    .chapter-num{ display:none; }
  }

  /* ---------- PROJECT ROWS ---------- */

  .project-row{
    display:flex; align-items: center; justify-content: space-between; gap: 18px;
    padding: 20px 0; padding-left: 46px;
    border-top: 1px solid var(--line);
    text-decoration: none;
    transition: padding-left .25s ease, color .25s ease;
  }
  .chapter .project-row:last-of-type{ border-bottom: 1px solid var(--line); }
  .project-row:hover, .project-row:focus-visible{ padding-left: 58px; color: var(--magenta); }

  .project-main{ display:flex; align-items: baseline; gap: 16px; min-width: 0; }
  .project-name{ font-family:'Bebas Neue', sans-serif; font-size: clamp(22px, 3.2vw, 30px); white-space: nowrap; }
  .project-desc{ color: var(--ink-dim); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .project-row:hover .project-desc, .project-row:focus-visible .project-desc{ color: inherit; }

  .project-right{ display:flex; align-items:center; gap: 14px; flex: none; }
  .project-city{
    font-size: 12px; color: var(--ink-dim);
    border: 1px solid var(--line); border-radius: 100px; padding: 4px 10px;
    white-space: nowrap;
  }
  .project-arrow{ font-size: 18px; transition: transform .25s ease; }
  .project-row:hover .project-arrow, .project-row:focus-visible .project-arrow{ transform: translate(3px,-3px); }

  @media (max-width: 620px){
    .project-row{ flex-direction: column; align-items: flex-start; gap: 8px; padding-left: 0; }
    .project-row:hover, .project-row:focus-visible{ padding-left: 0; }
    .project-main{ flex-direction: column; gap: 4px; }
    .project-desc{ white-space: normal; }
  }

  /* ---------- SERVICES ---------- */

  .service-grid{
    padding-left: 46px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .service-item{ background: var(--bg); padding: 22px; }
  .service-item h3{
    font-family:'Bebas Neue', sans-serif; font-size: 22px; font-weight:400;
    margin: 0 0 8px;
  }
  .service-item p{ color: var(--ink-dim); font-size: 14px; line-height: 1.5; }

  @media (max-width: 680px){
    .service-grid{ grid-template-columns: 1fr; padding-left: 0; }
  }

  .reels-row{
    padding-left: 46px; margin-top: 24px;
    display:grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  }
  .reels-card{ border: 1px solid var(--line); padding: 20px; }
  .reels-card .reel-label{
    font-family:'Bebas Neue', sans-serif; font-size: 22px; color: var(--gold);
    margin-bottom: 8px; display:block;
  }
  .reels-card p{ color: var(--ink-dim); font-size: 13px; line-height: 1.5; }
  @media (max-width: 680px){
    .reels-row{ grid-template-columns: 1fr; padding-left: 0; }
  }

  /* ---------- PRICING ---------- */

  .price-panel{
    margin-left: 46px;
    border: 1px solid var(--line);
    background: var(--bg-panel);
    padding: 40px;
  }
  @media (max-width: 680px){ .price-panel{ margin-left:0; padding: 28px 20px; } }

  .price-top{
    display:flex; justify-content: space-between; align-items: flex-end;
    flex-wrap: wrap; gap: 16px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px; margin-bottom: 28px;
  }
  .price-name{ font-family:'Bebas Neue', sans-serif; font-size: 28px; }
  .price-value{ font-family:'Bebas Neue', sans-serif; font-size: 44px; color: var(--gold); }
  .price-value small{ font-family:'Manrope',sans-serif; font-size: 14px; color: var(--ink-dim); font-weight:600; }

  .price-cols{ display:grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 28px; }
  @media (max-width: 680px){ .price-cols{ grid-template-columns: 1fr; } }

  .price-cols h4{
    font-family:'Bebas Neue', sans-serif; font-weight:400; font-size: 16px;
    color: var(--ink-dim); margin: 0 0 12px;
  }
  .price-cols ul{ margin:0; padding:0; list-style:none; }
  .price-cols li{
    font-size: 14px; line-height: 1.5; padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  .price-cols li:first-child{ border-top:none; }

  .price-note{
    font-size: 13px; color: var(--ink-dim); line-height: 1.6;
    border-top: 1px solid var(--line); padding-top: 20px;
  }
  .price-note strong{ color: var(--ink); }

  .price-extra{ margin-top: 16px; }
  .price-extra summary{ cursor:pointer; font-size: 13px; color: var(--ink); }
  .price-extra ul{ margin: 10px 0 0; padding-left: 18px; color: var(--ink-dim); font-size: 13px; line-height: 1.7; }

  /* ---------- TEAM ---------- */

  .team-row{
    padding-left: 46px;
    display:grid; grid-template-columns: 1fr 1fr; gap: 1px;
    background: var(--line); border: 1px solid var(--line);
  }
  @media (max-width: 680px){ .team-row{ grid-template-columns: 1fr; padding-left:0; } }

  .team-card{
    background: var(--bg); padding: 28px;
    display:flex; align-items:center; justify-content: space-between; gap: 12px;
    text-decoration: none; transition: background .2s ease;
  }
  .team-card:hover, .team-card:focus-visible{ background: var(--bg-panel); color: var(--magenta); }
  .team-name{ font-family:'Bebas Neue', sans-serif; font-size: 26px; display:block; }
  .team-role{ color: var(--ink-dim); font-size: 13px; }
  .team-arrow{ font-size: 18px; flex: none; }

  /* ---------- FOOTER ---------- */

